    "02": {
      "source": "curriculum/notes/week_02.md",
      "section_heading": "# Glossary",
      "reference_only": false,
      "original_rows": [
        {
          "original_term": "Autoencoder",
          "original_meaning": "Encoder–decoder network trained to reconstruct its input through a bottleneck",
          "term_keys": [
            "Autoencoder"
          ]
        },
        {
          "original_term": "Latent space",
          "original_meaning": "The space of codes z; in a VAE, shaped to match the prior",
          "term_keys": [
            "Latent space"
          ]
        },
        {
          "original_term": "Prior p(z)",
          "original_meaning": "Fixed distribution over codes, usually N(0, I)",
          "term_keys": [
            "Prior"
          ]
        },
        {
          "original_term": "Encoder $q_\\phi(z \\mid x)$",
          "original_meaning": "Network outputting a Gaussian over codes for an input; approximates the posterior",
          "term_keys": [
            "Encoder"
          ]
        },
        {
          "original_term": "Decoder $p_\\theta(x \\mid z)$",
          "original_meaning": "Network mapping a code to a distribution over data",
          "term_keys": [
            "Decoder"
          ]
        },
        {
          "original_term": "ELBO",
          "original_meaning": "Evidence lower bound: reconstruction term minus KL; maximised in training",
          "term_keys": [
            "ELBO"
          ]
        },
        {
          "original_term": "KL divergence",
          "original_meaning": "Non-negative, asymmetric measure of difference between distributions",
          "term_keys": [
            "KL divergence"
          ]
        },
        {
          "original_term": "Reparameterisation trick",
          "original_meaning": "Writing z = μ + σ ⊙ ε so sampling becomes differentiable",
          "term_keys": [
            "Reparameterisation"
          ]
        },
        {
          "original_term": "Posterior collapse",
          "original_meaning": "Failure where KL → 0 and the decoder ignores the code",
          "term_keys": [
            "Posterior collapse"
          ]
        },
        {
          "original_term": "β-VAE",
          "original_meaning": "VAE with the KL weighted by β, trading reconstruction for structure",
          "term_keys": [
            "β-VAE"
          ]
        },
        {
          "original_term": "VQ-VAE",
          "original_meaning": "VAE with a discrete codebook of latent vectors (image/audio tokens)",
          "term_keys": [
            "VQ-VAE"
          ]
        },
        {
          "original_term": "Latent interpolation",
          "original_meaning": "Decoding points on a path between two codes",
          "term_keys": [
            "Latent interpolation"
          ]
        },
        {
          "original_term": "Latent diffusion",
          "original_meaning": "Diffusion model operating in a VAE's latent space",
          "term_keys": [
            "Latent diffusion"
          ]
        }
      ],
